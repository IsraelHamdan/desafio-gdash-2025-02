# Dockerfile.dev - desenvolvimento com hot reload (Vite dev server)
FROM node:22-alpine

WORKDIR /app

# Copia apenas o necessário para instalar as deps
COPY package.json package-lock.json ./
RUN npm ci

# Copia o resto só para ter baseline (será sobrescrito por volumes em dev)
COPY . .

# Vite padrão
EXPOSE 5173

# Dev server ouvindo em 0.0.0.0 para funcionar dentro do container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
